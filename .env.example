# Digital Marketing Pro — Environment Variables
# Copy to .env and fill in the values you need. The plugin works without any of these.
# Enable only the integrations you use. See .mcp.json.example for full connector config.

# ── Google ──────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=
GA_PROPERTY_ID=
GSC_SITE_URL=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_API_KEY=

# ── SEO Tools ───────────────────────────────────────────
AHREFS_API_KEY=
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
SEMRUSH_API_KEY=

# ── Social / Ad Platforms ────────────────────────────────
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
