TIKTOK_ACCESS_TOKEN=
TIKTOK_AD_ACCOUNT_ID=
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
PINTEREST_ACCESS_TOKEN=

# ── Email / CRM ──────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
SALESFORCE_ACCESS_TOKEN=
